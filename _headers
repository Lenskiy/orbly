# Cloudflare Pages honours this file at deploy time.
# GitHub Pages ignores it (it is simply served as a static file), so it is a
# no-op for the orbly.to deployment.

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: geolocation=(), microphone=(), camera=()

# The glyph PNGs are not content-hashed — g3/g4 have already been swapped in
# place once — so cache for a week, never `immutable`, and keep bumping the
# ?v= query in index.html when an image is replaced.
/assets/*
  Cache-Control: public, max-age=604800

# Brand assets live at the site root because favicons, the Apple touch icon and
# the OG image are referenced by fixed absolute paths. Like the glyph PNGs they
# are not content-hashed, so cache for a week and never `immutable` — og.png in
# particular gets regenerated in place, and scrapers are re-primed by hand
# (Telegram @WebpageBot, the Facebook sharing debugger) rather than by a URL bump.
/favicon.svg
  Cache-Control: public, max-age=604800

/favicon.ico
  Cache-Control: public, max-age=604800

/apple-touch-icon.png
  Cache-Control: public, max-age=604800

/og.png
  Cache-Control: public, max-age=604800

/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate
